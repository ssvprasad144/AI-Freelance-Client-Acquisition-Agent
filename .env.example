DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=your-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example
DATABASE_URL=postgresql://...
OPENAI_API_KEY=...
OPENAI_MODEL=gpt-4o-mini
DISCOVERY_MODEL=gpt-4o-mini
DISCOVERY_MAX_RESULTS=20
DISCOVERY_SEARCH_CONTEXT_SIZE=medium
DEFAULT_DISCOVERY_QUERY=Find current freelance opportunities matching AI products, business automation, Django/React full-stack development, and Three.js interactive web development
QUALIFICATION_MIN_SCORE=60
FOLLOWUP_WORKER_INTERVAL=60
DISCOVERY_WORKER_INTERVAL=3600
SECURE_SSL_REDIRECT=true

# Guarded outbound email
OUTREACH_ENABLED=false
OUTREACH_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
