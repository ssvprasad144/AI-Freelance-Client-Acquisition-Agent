DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=your-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example
DATABASE_URL=postgresql://...
OPENAI_API_KEY=...
OPENAI_MODEL=gpt-4o-mini
DISCOVERY_MODEL=gpt-4o-mini
DISCOVERY_MAX_RESULTS=20
DISCOVERY_SEARCH_CONTEXT_SIZE=low
DEFAULT_DISCOVERY_QUERY=Find current freelance opportunities matching AI products, business automation, Django/React full-stack development, and Three.js interactive web development
QUALIFICATION_MIN_SCORE=60
FOLLOWUP_WORKER_INTERVAL=60
DISCOVERY_WORKER_INTERVAL=21600
DISCOVERY_QUERY_CACHE_TTL_HOURS=72
DISCOVERY_MAX_SEARCHES_PER_DAY=4
DISCOVERY_TARGET_QUALIFIED_LEADS=10
SECURE_SSL_REDIRECT=true

# Guarded outbound email
OUTREACH_ENABLED=false
OUTREACH_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Safe public-web crawler
CRAWLER_ENABLED=true
CRAWLER_USER_AGENT=SSVPrasad-ClientAcquisitionBot/1.0 (+public-web-research)
CRAWLER_TIMEOUT_SECONDS=8
CRAWLER_MIN_DELAY_SECONDS=2
CRAWLER_MAX_SLEEP_SECONDS=10
CRAWLER_MAX_PAGES_PER_DOMAIN=5
CRAWLER_MAX_LEADS_PER_CYCLE=5
CRAWLER_MAX_REDIRECTS=3
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_MAX_ROBOTS_BYTES=200000
CRAWLER_MAX_TEXT_CHARS=12000
CRAWLER_MAX_DESCRIPTION_CHARS=20000
CRAWLER_MAX_LINKS=50
CRAWLER_ALLOW_ROBOTS_FAILURE=false
